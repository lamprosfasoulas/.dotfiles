#!/usr/bin/env bash

MODE="basic"
CLUSTERS=( "cl100.it.auth.gr" "cl200.it.auth.gr" )
NAME="$1"
shift

usage() {
        echo
        echo -e "Usage findvm.sh <vm-name> [options]"
        echo -e "\t--raw full json output"
        echo -e "\t--id display vm id"
        echo -e "\t--node display vm node"
        echo
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --raw)
      MODE="raw"
      shift
      ;;
    --id)
      MODE="id"
      shift
      ;;
    --node)
      MODE="node"
      shift
      ;;
    *)
      echo "Unknown option: $1"
      exit 1
      ;;
  esac
done

if [[ -z "$NAME" ]]; then
        usage
        exit 1
fi

for cluster in "${CLUSTERS[@]}"; do
    echo -e "\e[36;1m=========================================\e[0m"
    echo -e "Querying cluster: \e[31;1m$cluster\e[0m"
    vms=$(ssh "$cluster" pvesh get /cluster/resources --output json --type vm 2>/dev/null)

    if ! jq . <<< "$vms" > /dev/null; then
        echo "Response is unparsable"
        exit 1
    fi

    search_result=$(jq --arg name "$NAME" -c '.[] | select(.name != null and (.name | contains($name)))' <<< "$vms")

    if [[ -z "$search_result" ]]; then
        echo
        echo -e "No VM found with name \e[31;1m$NAME\e[0m"
        echo
        continue 
    fi

    while read -r item; do
        node=$(jq -r '.node' <<< "$item")
        name=$(jq -r '.name' <<< "$item")
        id=$(jq -r '.id' <<< "$item" | cut -d'/' -f2-)

        echo -e "\e[1mFound VM: \e[33;1m$name\e[0m"
        if [[ "$MODE" == "raw" ]]; then
            jq '.' <<< "$item"
        elif [[ "$MODE" == "node" ]]; then
            echo -e "\e[31;1mNode:\e[0m \e[1m$id\e[0m"
        elif [[ "$MODE" == "id" ]]; then
            echo -e "\e[31;1mNode:\e[0m \e[1m$node\e[0m"
        else
            echo -e "\e[31;1mID:\e[0m \e[1m$id\e[0m"
            echo -e "\e[31;1mNode:\e[0m \e[1m$node\e[0m"
        fi
        echo "----------------------------------------"
    done <<< "$search_result"

done

